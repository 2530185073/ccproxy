# 复制为 .env 后修改：cp .env.example .env
# 密码只用字母、数字、- 和 _（不要包含 @ : / # ? % 等符号），可用以下命令生成：
#   openssl rand -hex 16

# ---- 版本 ----
# 镜像版本，升级时改这里。不要用 latest，避免客户机器自己漂到没验过的版本
CC2API_VERSION=1.8.32

# ---- 访问 ----
# 对外端口；只允许本机或反向代理访问时把 APP_BIND 改为 127.0.0.1
APP_BIND=0.0.0.0
APP_PORT=5674

# 管理后台：http://<服务器IP>:<APP_PORT>/<ADMIN_PATH>/
# 务必修改为强密码和不易猜测的路径
ADMIN_PASSWORD=change-me-admin-password
ADMIN_PATH=change-me-admin-path

# ---- PostgreSQL ----
POSTGRES_USER=ccproxy
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=claude_code_gateway

# ---- Redis ----
REDIS_PASSWORD=change-me-redis-password

# ---- 其他（可选）----
TZ=Asia/Shanghai
LOG_LEVEL=info
REQUEST_LOG_MAX_ROWS=20000
SYNTHETIC_LOG_MAX_ROWS=20000
# 设为 0 关闭限流恢复调度
USAGE_RECOVERY_ENABLED=1
